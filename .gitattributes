# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Windows-specific project and script files
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Source code and documentation strictly LF
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.inx text eol=lf
*.inf text eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf

# Binary files
*.bin binary
*.cer binary
*.cat binary
*.sys binary
*.dll binary
*.exe binary
*.pdb binary
*.wav binary
