%Amd.DeviceDesc% = Sof_Device, PCI\VEN_1022&DEV_15E2

; ================= Install Sections =================

[Sof_Device.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
sof_dsp.sys

[Sof_Device.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Wave%,Sof_Wave_Interface
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_Wave%,Sof_Wave_Interface
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_Wave%,Sof_Wave_Interface
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_Wave%,Sof_Wave_Interface

[Sof_Wave_Interface]
AddReg=Sof_Wave_Interface.AddReg

[Sof_Wave_Interface.AddReg]
HKR,,FriendlyName,,%Sof_Wave_Name%
HKR,,CLSID,,%Proxy.CLSID%

[Sof_Device.NT.Services]
AddService = sof_dsp,%SPSVCINST_ASSOCSERVICE%,Sof_Service_Inst

[Sof_Service_Inst]
DisplayName    = %Sof.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\sof_dsp.sys
AddReg         = Sof_Service_Inst.AddReg

[Sof_Service_Inst.AddReg]
HKR,Parameters,SafeBootPolicy,0x00010001,2
HKR,Parameters,BootSafetyToken,0x00010001,0
HKR,Parameters,ArmedTesting,0x00010001,1
HKR,Parameters,EnablePortCls,0x00010001,1
HKR,Parameters,EnableS0Idle,0x00010001,1
HKR,Parameters,S0IdleTimeoutMs,0x00010001,5000
HKR,Parameters,SimulateJackState,0x00010001,4
HKR,Parameters,EnableUsbOffload,0x00010001,1

; ================= KMDF WDF Section =================

[Sof_Device.NT.Wdf]
KmdfService = sof_dsp, Sof_wdfsect

[Sof_wdfsect]
KmdfLibraryVersion = 1.35

; ================= Strings =================

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ProviderName = "Sound Open Firmware Project"
MfgName = "Sound Open Firmware"
DiskName = "SOF Driver Installation Disk"
Sof.SVCDESC = "Sound Open Firmware DSP Service"
Intel.DeviceDesc = "Intel Sound Open Firmware Audio DSP"
Amd.DeviceDesc = "AMD Sound Open Firmware Audio DSP"
Sof_Wave_Name = "Sound Open Firmware Wave Audio"
KSNAME_Wave = "Wave"
Proxy.CLSID = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
