[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
CatalogFile=sof_dsp.cat
DriverVer=09/23/2026,1.0.0.106
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
sof_dsp.sys = 1,,

; ================= Manufacturer & Models =================

[Manufacturer]
%MfgName% = Intel,NT$ARCH$.10.0...16299

[Intel.NT$ARCH$.10.0...16299]
; Intel Panther Lake, Wildcat Lake & Nova Lake (ACE 3.0)
%Intel.DeviceDesc% = Sof_Device, PCI\VEN_8086&DEV_E428
