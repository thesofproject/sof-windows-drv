%Intel.DeviceDesc% = Sof_Device, PCI\VEN_8086&DEV_4B55
%Intel.DeviceDesc% = Sof_Device, PCI\VEN_8086&DEV_4B58
%Intel.DeviceDesc% = Sof_Device, PCI\VEN_8086&DEV_4DC8

; Intel Cannon Lake, Comet Lake & Coffee Lake (cAVS 1.8)
%Intel.DeviceDesc% = Sof_Device, PCI\VEN_8086&DEV_9DC8
